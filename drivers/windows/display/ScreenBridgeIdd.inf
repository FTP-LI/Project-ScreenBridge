;
; ScreenBridge indirect display driver.
; Creates one software display adapter. It does not replace existing display drivers.
;

[Version]
Signature   = "$Windows NT$"
Class       = Display
ClassGuid   = {4D36E968-E325-11CE-BFC1-08002BE10318}
Provider    = %ManufacturerName%
CatalogFile = ScreenBridgeIdd.cat
DriverVer   = 11/04/2026,1.0.1.2
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0...22000

[Standard.NTamd64.10.0...22000]
%DeviceName% = ScreenBridge_Install, Root\ScreenBridgeIdd
%DeviceName% = ScreenBridge_Install, ScreenBridgeIdd

[SourceDisksFiles]
ScreenBridgeIdd.dll = 1

[SourceDisksNames]
1 = %DiskName%

[DestinationDirs]
UMDriverCopy = 12,UMDF

[ScreenBridge_Install.NT]
Include    = WUDFRD.inf
Needs      = WUDFRD.NT
CopyFiles  = UMDriverCopy

[ScreenBridge_Install.NT.hw]
Include = WUDFRD.inf
Needs   = WUDFRD.NT.HW
AddReg  = ScreenBridge_HardwareDeviceSettings

[ScreenBridge_HardwareDeviceSettings]
HKR,, "UpperFilters", %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "ScreenBridgeIddGroup"
HKR,, Security,, "D:P(A;;GA;;;BA)(A;;GA;;;SY)(A;;GA;;;UD)"

[ScreenBridge_Install.NT.Services]
Include = WUDFRD.inf
Needs   = WUDFRD.NT.Services

[ScreenBridge_Install.NT.Wdf]
UmdfService                 = ScreenBridgeIdd, ScreenBridgeIdd_Install
UmdfServiceOrder            = ScreenBridgeIdd
UmdfKernelModeClientPolicy  = AllowKernelModeClients

[ScreenBridgeIdd_Install]
Include            = WUDFRD.inf
Needs              = WUDFRD.NT
UmdfLibraryVersion = 2.25.0
ServiceBinary      = %12%\UMDF\ScreenBridgeIdd.dll
UmdfExtensions     = IddCx0102

[UMDriverCopy]
ScreenBridgeIdd.dll

[Strings]
ManufacturerName = "ScreenBridge"
DiskName         = "ScreenBridge Display"
DeviceName       = "ScreenBridge Display"
REG_MULTI_SZ     = 0x00010000
REG_SZ           = 0x00000000
